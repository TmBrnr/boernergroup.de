    "test:publisher": "node --conditions=react-server --import tsx --test scripts/test-publisher.ts"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.41.0",
    "@chat-adapter/state-redis": "^4.41.0",
    "@vercel/queue": "^0.1.7",
    "chat": "^4.41.0",
    "framer-motion": "12.43.0",
    "next": "^16.3.6",
    "next-mdx-remote": "^6.0.0",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "22.13.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "$postcss",
