{
  "name": "boernergroup",
  "version": "1.0.0",
  "private": true,
  "description": "boernergroup.de, the personal site of Tobias Boerner",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
