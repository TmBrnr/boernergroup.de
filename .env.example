# Public site origin, used for canonical URLs, sitemap, RSS and OG images
NEXT_PUBLIC_SITE_URL=https://boernergroup.de

# Where every form submission is delivered
CONTACT_RECIPIENT=mail@boernergroup.de

# Recommended on Vercel: install Resend from the Marketplace. It provisions
# RESEND_API_KEY automatically. Verify boernergroup.de in Resend before using
# this sender address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Boerner Group Website <mail@boernergroup.de>

# Optional alternative: forward submissions to an existing form backend.
# If neither this nor RESEND_API_KEY is configured, the API returns a clear
# unavailable state and never claims that an unsent message was delivered.
CONTACT_FORM_ENDPOINT=
NEWSLETTER_FORM_ENDPOINT=

# Slack article publisher (optional; see docs/SLACK-PUBLISHER.md)
# These credentials should belong to the website owner, not the developer who
# initially sets up the integration. OpenAI API usage is billed separately from
# ChatGPT Plus, Pro, Business, or Enterprise subscriptions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=max
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# Fine-grained token for this repository only: Contents (read/write). The bot
# commits article changes directly to the production branch. Never expose this
# token to Slack or to the model prompt.
GITHUB_TOKEN=
GITHUB_REPOSITORY=TmBrnr/boernergroup.de
GITHUB_DEFAULT_BRANCH=main

# Comma-separated Slack IDs. The channel list is optional. The publisher list
# is mandatory: only these users may publish or delete website articles.
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_PUBLISHER_USER_IDS=
PUBLISHER_BOT_NAME=Boerner Publisher
